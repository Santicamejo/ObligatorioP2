@using Dominio
@model List<Pago>

<h1>Mis pagos</h1>

@if (Model == null || Model.Count == 0)
{
    <p>No tenés pagos registrados.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Tipo de pago</th>
                <th>Descripcion</th>
                <th>Fecha</th>
                <th>Metodo de pago</th>
                <th>Monto</th>
            </tr>
        </thead>
        <tbody>
            @foreach(Pago unP in Model)
            {
                <tr>
                    <td>@(unP is PagoUnico ? "Pago único" : "Pago recurrente")</td>
                    <td>@unP.Descripcion</td>
                    <td> @(unP is PagoUnico elPU ? elPU.Fecha : ((PagoRecurrente)unP).Desde)</td>
                    <td>@unP.MetodoPago</td>
                    <td>@unP.CalcularMontoTotal()</td>
                </tr>
            }
        </tbody>
    </table>
}

<a class="btn btn-success" href="/Payments/SelectPaymentType">Cargar nuevo pago</a>