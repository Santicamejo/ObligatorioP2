@using Dominio

<h1>Mi perfil</h1>
<br />

<p><strong>Rol - </strong>@Context.Session.GetString("rol")</p>
<p><strong>Nombre - </strong>@ViewBag.Usuario.Nombre @ViewBag.Usuario.Apellido</p>
<p><strong>Email - </strong>@ViewBag.Usuario.Email</p>
<p><strong>Fecha de incorporación - </strong>@ViewBag.Usuario.EmpleadoDesde</p>
<p><strong>Equipo - </strong>@ViewBag.Usuario.Equipo.Nombre</p>
<p><strong>Gastos del mes - </strong>@ViewBag.GastosMes</p>


@if (Context.Session.GetString("rol") == "Gerente")

{
    <br />
    <h2>Miembros de su equipo</h2>
    <table class="table">
        <thead>
        <th>Email</th>
        <th>Nombre</th>
        <th>Fecha incorporación</th>
        <th>Rol</th>
        </thead>
        <tbody>
            @foreach (Usuario unU in ViewBag.ListadoEmpleados)
            {
                if (unU.Email != Context.Session.GetString("email"))
                {
                    <tr>
                        <td>@unU.Email</td>
                        <td>@unU.Nombre @unU.Apellido</td>
                        <td>@unU.EmpleadoDesde</td>
                        <td>@unU.Rol</td>
                    </tr>
                }
            }
        </tbody>
    </table>
}